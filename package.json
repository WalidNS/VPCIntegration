{
  "name": "n8n-integration",
  "version": "1.0.0",
  "description": "A small integration with n8n MCP ",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/main.js",
    "dev": "tsc && node dist/main.js",
    "dev:watch": "tsc --watch & node --watch dist/main.js",
    "test": "node test-runner.js",
    "test:watch": "node test-runner.js --watch",
    "test:coverage": "node test-runner.js --coverage",
    "test:unit": "node test-runner.js src/__tests__/openAiConnection.test.ts",
    "test:integration": "node test-runner.js src/__tests__/openAiConnection.integration.test.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "mcp:example": "tsc && node dist/main.js",
    "mcp:dev": "tsc && node dist/main.js"
  },
  "keywords": [
    "n8n",
    "MCP",
    "chatgpt"
  ],
  "author": "Walid Nsiri",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.3.1",
    "openai": "^5.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
